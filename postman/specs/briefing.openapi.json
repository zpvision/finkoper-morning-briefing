{
  "openapi": "3.0.3",
  "info": {
    "title": "FinKoper Утренний обзор",
    "version": "1.0.0",
    "description": "Trusted backend API; company_id is tenant scope, not user authorization. Limits: 1 MiB body, 200 total messages, local Qwen3 token budget: input_tokens + 1500 <= 8192. Context before from; messages in [from,to); unique IDs across both groups. No silent truncation. Idempotency normalizes JSON and absent/null/empty context, preserving array order."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18084"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Application and SQLite respond; no model call",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/briefings": {
      "post": {
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted; same company and key returns same job even at capacity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job_id",
                    "status",
                    "created_at"
                  ],
                  "properties": {
                    "job_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "succeeded",
                        "failed"
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing Idempotency-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Key exists with different normalized content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Local tokenizer budget exceeded; no truncation. Safe numeric diagnostics, no message text.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "input_tokens",
                    "output_reserve",
                    "context_tokens",
                    "required_tokens",
                    "remaining_tokens",
                    "method",
                    "compatibility_verified"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "input_budget_exceeded"
                      ]
                    },
                    "input_tokens": {
                      "type": "integer"
                    },
                    "output_reserve": {
                      "type": "integer"
                    },
                    "context_tokens": {
                      "type": "integer"
                    },
                    "required_tokens": {
                      "type": "integer"
                    },
                    "remaining_tokens": {
                      "type": "integer"
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "qwen3_tokenizers_ollama_template_no_normalization"
                      ]
                    },
                    "compatibility_verified": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "100 queued + running jobs; retry after 5 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "5 seconds"
              }
            }
          },
          "500": {
            "description": "Storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Helper unavailable/timed out or runtime compatibility not verified. No byte fallback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/briefings/{job_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "company_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status and nullable result; error is a safe code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing Idempotency-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing job or another company",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "conversation_id",
          "channel",
          "sent_at",
          "sender_role",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "max",
              "telegram",
              "finchat"
            ]
          },
          "sent_at": {
            "type": "string",
            "format": "date-time"
          },
          "sender_role": {
            "type": "string",
            "enum": [
              "client",
              "staff"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Maximum 16000 UTF-8 bytes; nonblank."
          }
        }
      },
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company_id",
          "client_id",
          "period",
          "messages"
        ],
        "properties": {
          "company_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "context_messages": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        }
      },
      "Topic": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "status",
          "deadline_text",
          "needs_context",
          "source_message_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_staff",
              "awaiting_client",
              "resolved",
              "unclear"
            ]
          },
          "deadline_text": {
            "type": "string",
            "nullable": true
          },
          "needs_context": {
            "type": "boolean"
          },
          "source_message_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "job_id",
          "status",
          "created_at",
          "prompt_version",
          "schema_version",
          "result",
          "error",
          "metrics"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "prompt_version": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "nullable": true,
            "required": [
              "topics"
            ],
            "properties": {
              "topics": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Topic"
                }
              }
            }
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "metrics": {
            "type": "object",
            "properties": {
              "queue_wait_ms": {
                "type": "integer",
                "nullable": true
              },
              "processing_ms": {
                "type": "integer",
                "nullable": true
              },
              "ollama_total_ms": {
                "type": "number",
                "nullable": true
              },
              "ollama_load_ms": {
                "type": "number",
                "nullable": true
              },
              "prompt_eval_ms": {
                "type": "number",
                "nullable": true
              },
              "generation_ms": {
                "type": "number",
                "nullable": true
              },
              "input_tokens": {
                "type": "integer",
                "nullable": true
              },
              "output_tokens": {
                "type": "integer",
                "nullable": true
              },
              "budget_helper_ms": {
                "type": "integer",
                "nullable": true,
                "description": "Worker budget-check wall time: slot wait, Python startup, resource checks, tokenizer loading and count. Null if not executed; measured zero is 0. Excludes request admission/startup probe."
              },
              "compatibility_check_ms": {
                "type": "integer",
                "nullable": true,
                "description": "Worker Verify wall time before generation, including its Python subprocess and metadata/render-only HTTP checks. Null if not executed; persisted even on verification failure. No generation on failure."
              }
            }
          }
        }
      }
    }
  }
}
