[Unit]
Description=FinKoper Morning Briefing
After=network.target

[Service]
Type=simple
User=finkoper-briefing
Group=finkoper-briefing
WorkingDirectory=/opt/finkoper-morning-briefing/current
EnvironmentFile=/etc/finkoper-morning-briefing.env
ExecStart=/opt/finkoper-morning-briefing/current/briefing
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
# Set BRIEFING_BUDGET_PYTHON=/opt/finkoper-morning-briefing/venv-budget/bin/python
# in EnvironmentFile. Venv and tokenizer resources are owned by root, read-only here.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/finkoper-morning-briefing

[Install]
WantedBy=multi-user.target
